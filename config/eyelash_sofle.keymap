#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    macros {
        mo1_rgb: mo1_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo 1>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(200,100,40)>
                , <&macro_pause_for_release>
                , <&macro_release &mo 1>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(30,20,25)>
                ;
        };

        mo2_rgb: mo2_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo 2>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(270,80,35)>
                , <&macro_pause_for_release>
                , <&macro_release &mo 2>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(30,20,25)>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Main";
            bindings = <
// ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮  ╭──────────╮  ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
    &kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5        &kp UP         &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
    &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T         &kp LEFT       &kp Y      &kp U      &kp I      &kp O      &kp P      &kp MINUS
    &kp CAPS   &kp A      &kp S      &kp D      &kp F      &kp G         &kp RET        &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
    &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B         &kp RIGHT      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RET
    &trans     &kp LALT   &kp LGUI   &kp LCTRL  &mo1_rgb   &trans        &kp DOWN       &trans     &mo2_rgb   &kp DEL    &kp LSHFT  &kp RCTRL
// ╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯  ╰──────────╯  ╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            display-name = "Nav/Num";
            bindings = <
// ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮  ╭──────────╮  ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
// |          | F1       | F2       | F3       | F4       | F5       |  |          |  |          | /        | *        | [  ({)   | ]  (})   | BSPC     |
    &trans     &kp F1     &kp F2     &kp F3     &kp F4     &kp F5        &trans         &trans     &kp FSLH   &kp KP_MULTIPLY &kp LBKT &kp RBKT  &kp BSPC
// |          | Home     | ↑        | End      | PgUp     |          |  |          |  | 7        | 8        | 9        | -        |          |          |
    &trans     &kp HOME   &kp UP     &kp END    &kp PG_UP  &trans        &trans         &kp N7     &kp N8     &kp N9     &kp MINUS  &trans     &trans
// |          | ←        | ↓        | →        | PgDn     |          |  |          |  | 4        | 5        | 6        | +        |          |          |
    &trans     &kp LEFT   &kp DOWN   &kp RIGHT  &kp PG_DN  &trans        &trans         &kp N4     &kp N5     &kp N6     &kp KP_PLUS &trans    &trans
// |          |          |          |          |          |          |  |          |  | 1        | 2        | 3        | Enter    |          |          |
    &trans     &trans     &trans     &trans     &trans     &trans        &trans         &kp N1     &kp N2     &kp N3     &kp KP_ENTER &trans   &trans
// |          |          |          |          | [held]   |          |  |          |  |          |          | 0        | .        |          |
    &trans     &trans     &trans     &trans     &mo1_rgb   &trans        &trans         &trans     &trans     &kp N0     &kp KP_DOT &trans
// ╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯  ╰──────────╯  ╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            display-name = "Fn/Sys";
            bindings = <
// ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮  ╭──────────╮  ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
// | `        | BT 0     | BT 1     | BT 2     | BT 3     | BT 4     |  |          |  | F6       | F7       | F8       | F9       | F10      |          |
    &kp GRAVE  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &trans  &kp F6  &kp F7     &kp F8     &kp F9     &kp F10    &trans
// |          |          |          |          |          |          |  |          |  |          |          |          | F11      | F12      |          |
    &trans     &trans     &trans     &trans     &trans     &trans        &trans         &trans     &trans     &trans     &kp F11    &kp F12    &trans
// |          | USB      | BLE      |          |          |          |  |          |  |          |          |          |          |          |          |
    &trans     &out OUT_USB &out OUT_BLE &trans &trans     &trans        &trans         &trans     &trans     &trans     &trans     &trans     &trans
// |          | Reset    |          | Boot     |          |          |  |          |  |          | Reset    | Soft off | Boot     |          |          |
    &trans     &sys_reset &trans     &bootloader &trans    &trans        &trans         &trans     &sys_reset &soft_off  &bootloader &trans    &trans
// |          |          |          |          |          |          |  |          |  |          | [held]   | BT clr   | BT clr   |          |
    &trans     &trans     &trans     &trans     &trans     &trans        &trans         &trans     &mo2_rgb   &bt BT_CLR_ALL &bt BT_CLR &trans
// ╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯  ╰──────────╯  ╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
